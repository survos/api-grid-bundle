      "datatables.net-responsive-bs5": "4.1.1",
      "datatables.net-responsive-bs5/css/responsive.bootstrap5.css": "4.1.1",
      "datatables.net-searchbuilder-bs5": "2.1.1",
      "datatables.net-searchbuilder-bs5/css/searchBuilder.bootstrap5.css": "2.1.1",
      "datatables.net-select-bs5": "4.1.1",
      "datatables.net-select-bs5/css/select.bootstrap5.css": "4.1.1",
      "datatables.net-columncontrol": "2.1.2",
