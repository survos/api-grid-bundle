    "datatables.net": "3.1.3",
    "datatables.net-bs5": "3.1.3",
    "datatables.net-buttons-bs5": "4.1.2",
    "datatables.net-responsive": "4.1.1",
    "datatables.net-responsive-bs5": "4.1.1",
    "datatables.net-searchbuilder-bs5": "2.1.1",
    "datatables.net-select-bs5": "4.1.1",
